# Doxygen configuration of RadCluster. Run from the repository root:
#
#     doxygen docs/doxygen/Doxyfile
#
# The HTML goes to docs/doxygen/build/html/ (not tracked). Only the settings that differ from Doxygen's
# defaults are listed. docs/doxygen/README.md explains what is documented and how it is published.

PROJECT_NAME           = "RadCluster"
PROJECT_NUMBER         = 2.2.0
PROJECT_BRIEF          = "Graph-based cluster dynamics for irradiated materials"
OUTPUT_DIRECTORY       = docs/doxygen/build

# ── What is read ───────────────────────────────────────────────────────────────
# The Python package (abstract core, EUROFER-97 declaration, orchestration, post-processing), the C++ solver,
# the test and figure scripts, and the calibration and verification campaign. The module's physics and solver
# reference (radcluster_code/CLAUDE.md) becomes a page.
INPUT                  = docs/doxygen/mainpage.md \
                         radcluster_code/CLAUDE.md \
                         radcluster_code/py_utils \
                         radcluster_code/cpp_utils \
                         radcluster_code/codes \
                         radcluster_code/digital_twin
RECURSIVE              = YES
FILE_PATTERNS          = *.py *.h *.hpp *.cpp
USE_MDFILE_AS_MAINPAGE = docs/doxygen/mainpage.md
EXCLUDE_PATTERNS       = */build/* \
                         */__pycache__/* \
                         */.ipynb_checkpoints/* \
                         */output/* \
                         */archive/* \
                         */digital_twin/results/* \
                         */digital_twin/design/* \
                         */digital_twin/verification/.sync/* \
                         */digital_twin/verification/logs/*
# The physics reference writes its equations as $...$ and $$...$$, which GitHub renders and Doxygen does not.
# The filter rewrites them as Doxygen formulas; it changes nothing else and is applied to that one file.
FILTER_PATTERNS        = */CLAUDE.md="python3 docs/doxygen/markdown_math_filter.py"

# ── What is shown ──────────────────────────────────────────────────────────────
# The code documents itself with module and function docstrings (Python) and header comments (C++), not with
# Doxygen commands, so every entity is extracted and docstrings are shown as written.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
PYTHON_DOCSTRING       = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
SORT_MEMBER_DOCS       = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

# ── Output ─────────────────────────────────────────────────────────────────────
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
USE_MATHJAX            = YES
# The physics reference uses \dfrac and \text, which MathJax loads from its AMS extensions.
MATHJAX_EXTENSIONS     = TeX/AMSmath TeX/AMSsymbols

# ── Messages ───────────────────────────────────────────────────────────────────
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = NO
WARN_LOGFILE           = docs/doxygen/build/warnings.log
